{
  "name": "serato-library-manager",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build_frontend.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint src e2e",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "check": "tsc --noEmit && tsc --noEmit -p e2e && eslint src e2e && vitest run && node scripts/build_frontend.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
